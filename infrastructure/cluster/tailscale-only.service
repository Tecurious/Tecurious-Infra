# Drops the listed host ports on every interface except tailscale0 and lo (localhost),
# for IPv4 and IPv6. Rules live in the TS-ONLY chain, jumped to from INPUT.
#   22     SSH
#   11434  Ollama (listens on 0.0.0.0; see ollama-override.conf)
# Installed by firewall-block-nodeports.sh to /etc/systemd/system/.
# To add a port: edit PORTS, re-run the script.
# Break-glass (at the machine, Tailscale down): sudo systemctl stop tailscale-only
#   This opens SSH *and* Ollama on every interface until you start it again.
[Unit]
Description=Allow selected host ports only over Tailscale
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PORTS=22,11434
ExecStart=/bin/sh -c 'for t in iptables ip6tables; do \
    $t -N TS-ONLY 2>/dev/null; $t -F TS-ONLY; \
    $t -A TS-ONLY -i lo -j RETURN; \
    $t -A TS-ONLY -i tailscale0 -j RETURN; \
    $t -A TS-ONLY -j DROP; \
    $t -C INPUT -p tcp -m multiport --dports $PORTS -j TS-ONLY 2>/dev/null || $t -I INPUT -p tcp -m multiport --dports $PORTS -j TS-ONLY; \
    $t -D INPUT ! -i tailscale0 -p tcp -m multiport --dports $PORTS -j DROP 2>/dev/null || true; \
  done'
ExecStop=/bin/sh -c 'for t in iptables ip6tables; do \
    $t -D INPUT -p tcp -m multiport --dports $PORTS -j TS-ONLY 2>/dev/null; \
    $t -F TS-ONLY 2>/dev/null; $t -X TS-ONLY 2>/dev/null; \
  done; true'

[Install]
WantedBy=multi-user.target
